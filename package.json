{
	"name": "n8n-nodes-conv2pdf",
	"version": "1.2.0",
	"description": "Official n8n node for the Conv2pdf API: convert and manipulate PDF files in your workflows (Word, Excel, PowerPoint, e-books, HTML and web pages to PDF, PDF to Word, merge, split, compress and more), hosted in the EU (France).",
	"license": "MIT",
	"homepage": "https://conv2pdf.com/en/api/",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"conv2pdf",
		"pdf",
		"pdf conversion",
		"word to pdf",
		"docx to pdf",
		"pdf to word",
		"html to pdf",
		"url to pdf",
		"epub to pdf",
		"xps to pdf",
		"merge pdf",
		"compress pdf"
	],
	"author": {
		"name": "Jamal Tantaoui",
		"email": "contact@conv2pdf.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/conv2pdf/n8n.git"
	},
	"bugs": {
		"url": "https://github.com/conv2pdf/n8n/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/Conv2pdfApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Conv2pdf/Conv2pdf.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^1.0.1",
		"eslint": "10.14.0",
		"prettier": "3.9.10",
		"release-it": "^21.1.2",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
